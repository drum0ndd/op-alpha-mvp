{
  "name": "@op-alpha/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "corepack pnpm prisma:generate && nest start --watch",
    "build": "corepack pnpm prisma:generate && nest build",
    "start": "node dist/main.js",
    "lint": "tsc --noEmit && tsc -p tsconfig.seed.json",
    "test": "corepack pnpm test:unit",
    "test:unit": "corepack pnpm build && vitest run --exclude test/users.database.test.ts --exclude test/catalog.database.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "test:integration": "node ../../scripts/test-app.mjs --database-only",
    "prisma:deploy": "prisma migrate deploy",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.seed.json",
    "catalog:sync": "corepack pnpm build && node dist/jobs/catalog-cli.js",
    "catalog:import": "corepack pnpm build && node dist/jobs/catalog-cli.js --write"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-fastify": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@op-alpha/contracts": "workspace:*",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.0.0",
    "fastify": "^5.6.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "prisma": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
